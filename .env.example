# Copy to .env and set the Supabase PostgreSQL connection URL.
DATABASE_URL=

# Private Supabase Storage bucket for invoice attachments.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INVOICE_BUCKET=invoice-documents

# Frontend and optional server-side integrations
FRONTEND_URLS=http://localhost:5173,http://localhost:3000
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
WORKFORCE_COOKIE_SECURE=false
REDIS_URL=

# SMTP is status-only; outbound email delivery is not implemented.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional Vite development proxy override.
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_BASE_URL=
